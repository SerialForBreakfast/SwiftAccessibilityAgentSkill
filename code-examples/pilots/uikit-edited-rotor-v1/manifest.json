  "revision": "1",
  "platform": "iOS",
  "deploymentTarget": "26.0",
  "runtimeMajor": 26,
  "limitations": "Unit-only literal text search and direct native rotor callbacks. No actual VoiceOver navigation, speech or edit delivery. Caller refreshes after document updates; first new-epoch search restarts. Canonical equivalence and fuzzy matching are not implemented.",
  "claims": [
    {
      "id": "rotor",
      "url": "https://developer.apple.com/documentation/uikit/uiaccessibilitycustomrotor",
      "section": "UIAccessibilityCustomRotor.h itemSearchBlock/currentItem/direction",
      "statement": "Native rotor search receives current result and direction. Revision invalidation and first-search restart are explicit application policy, not UIKit guarantees.",
      "reviewedOn": "2026-11-05",
      "availability": "Custom rotors iOS10+; established UITextInput/Foundation APIs; deployment26.0."
    },
    {
      "id": "ranges",
      "url": "https://developer.apple.com/documentation/uikit/uiaccessibilitycustomrotoritemresult/targetrange",
      "section": "UIAccessibilityCustomRotor.h targetRange; UITextInput.h positions/offset/range methods",
      "statement": "Return ranges belonging to the text input, using UTF16 offsets; unit tests inspect text/ranges without claiming assistive-technology navigation.",
      "reviewedOn": "2026-11-05",
      "availability": "Custom rotors iOS10+; established UITextInput/Foundation APIs; deployment26.0."
    },
    {
      "id": "matching",
      "url": "https://developer.apple.com/documentation/foundation/nsstring/range(of:options:range:)",
      "section": "NSString.h literal search; Swift.String UTF16 and Character views",
      "statement": "Foundation performs literal matching. Whole-grapheme filtering, optional overlap and empty-query behavior are project matching policy.",
      "reviewedOn": "2026-11-05",
      "availability": "Custom rotors iOS10+; established UITextInput/Foundation APIs; deployment26.0."
    }
  ],

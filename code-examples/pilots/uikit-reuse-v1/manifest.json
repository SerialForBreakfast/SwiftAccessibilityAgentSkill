  "limitations": "Metadata, direct reuse hooks, injected notification arguments and font configuration only. No UI tests, dequeue delivery or system notification delivery.",
  "claims": [
    {
      "id": "reuse",
      "url": "https://developer.apple.com/documentation/uikit/uicollectionreusableview/prepareforreuse()",
      "section": "UICollectionViewCell.h prepareForReuse; UIAccessibility.h attributed labels/traits/actions; UIAccessibilityConstants.h speech-language attribute",
      "statement": "Explicit cell configuration and reuse reset metadata; generation guards and callback ownership are example policy. Direct reuse hook invocation, not collection dequeue delivery.",
      "availability": "Deployment26.0; speech attributed labels available iOS11+.",
      "reviewedOn": "2026-11-05"
    },
    {
      "id": "section",
      "url": "https://developer.apple.com/documentation/uikit/uiaccessibilitycontainer",
      "section": "UIAccessibilityContainer.h elements/type; UIAccessibilityConstants.h header trait",
      "statement": "Nested semantic-group/list configuration and heading role transitions preserve unrelated traits; no spoken order claim.",
      "availability": "Container types iOS11+; deployment26.0.",
      "reviewedOn": "2026-11-05"
    },
    {
      "id": "typography",
      "url": "https://developer.apple.com/documentation/uikit/uifont/preferredfont(forTextStyle:compatibleWith:)",
      "section": "UIFont.h preferredFontForTextStyle; UILabel.h adjustsFontForContentSizeCategory/numberOfLines; UIView.h updateTraitsIfNeeded",
      "statement": "Reusable font configuration uses the receiving label trait environment; tests override its size category. No rendered layout claim.",
      "availability": "Deployment26.0.",
      "reviewedOn": "2026-11-05"
    },
    {
      "id": "notification",
      "url": "https://developer.apple.com/documentation/uikit/uiaccessibility/notification",
      "section": "UIAccessibilityConstants.h layoutChanged/screenChanged optional element argument",
      "statement": "Build notification kind and target argument and deliver to an injected recording closure; no system notification is posted.",
      "availability": "Deployment26.0.",
      "reviewedOn": "2026-11-05"
    }
  ],

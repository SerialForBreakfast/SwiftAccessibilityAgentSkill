      "availability": "Pilot deployment26.0.",
      "reviewedOn": "2026-11-05"
    },
    {
      "id": "actions",
      "url": "https://developer.apple.com/documentation/uikit/uiaccessibilitycustomaction",
      "section": "Overview; actionHandler; UIAccessibilityCustomAction.h",

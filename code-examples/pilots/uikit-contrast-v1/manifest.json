      "id": "resolution",
      "url": "https://developer.apple.com/documentation/uikit/uicolor/resolvedcolor(with:)",
      "section": "UIColor.h resolvedColorWithTraitCollection and dynamic provider",
      "statement": "Resolve UIColor for explicit appearance and accessibility-contrast traits before numerical inspection. The semantic pair threshold is project validation, not an Apple guarantee for every color or version.",
      "availability": "Color resolution iOS13+; deployment26.0.",
      "reviewedOn": "2026-11-05"
    },
    {
      "id": "conversion",

    {
      "id": "forwarding-macos-v1/native-actions",
      "platform": "macOS",
      "framework": "SwiftUI",
      "nativeFramework": "AppKit",
      "family": "native-actions",
      "subject": {
        "path": "code-examples/swiftui/forwarding-macos-v1/evaluation/native-actions.prompt.md",
        "text": "Target macOS26, SwiftUI with AppKit.\n\nFor the same SwiftUI native report card, preserve ordinary Open and Details controls. Add one optional Details accessibility shortcut through the same callback. Updates change the stable item ID and handler; old shortcuts or detached native controls must not invoke a rebound item. Respect externally disabled controls, replace rather than accumulate handlers, and stop dispatch on dismantle. Retained actions must not retain the coordinator or card.\n\nProvide complete code and focused unit tests; no UI automation.\n",
        "sha256": "3e267fb278622b360458072ce4c60fa467479c5f17965641b0728917d3660f79"
      },
      "rubric": {
        "path": "code-examples/swiftui/forwarding-macos-v1/evaluation/native-actions.rubric.md",
        "sha256": "fb4c0f47051104a8a36253d4ccb3318666963fb6c013c4a676483e7ab39d46a2"
      },
      "manifest": "code-examples/swiftui/forwarding-macos-v1/manifest.json",
      "testIds": [
        "ForwardingTests/testOrdinaryPrimaryUsesCurrentID",
        "ForwardingTests/testOrdinarySecondaryRemainsIndependent",
        "ForwardingTests/testShortcutUsesSameSecondaryPath",
        "ForwardingTests/testOldShortcutCannotReachNewItem",
        "ForwardingTests/testOldOrdinaryControlCannotReachReboundSurface",
        "ForwardingTests/testExternallyDisabledPrimaryRejectsCapturedAction",
        "ForwardingTests/testExternallyDisabledSecondaryRejectsShortcut",
        "ForwardingTests/testDisabledSnapshotRejectsBothCallbacks",
        "ForwardingTests/testStopInvalidatesCapturedAction",
        "ForwardingTests/testRepeatedConfigureDoesNotDuplicateNativeHandler",
        "ForwardingTests/testShortcutListDoesNotAccumulate",
        "ForwardingTests/testCallbackDoesNotRetainOwner",
        "ForwardingTests/testNativeSurfaceNotRetainedByOwner",
        "ForwardingTests/testPublicDismantleStopsNativeDispatch"
      ],
      "outputs": {

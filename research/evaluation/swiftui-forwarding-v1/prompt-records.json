        "attempts": []
      },
      "analysis": null
    },
    {
      "id": "forwarding-macos-v1/preference-forwarding",
      "platform": "macOS",
      "framework": "SwiftUI",
      "nativeFramework": "AppKit",
      "family": "preference-forwarding",
      "subject": {
        "path": "code-examples/swiftui/forwarding-macos-v1/evaluation/preference-forwarding.prompt.md",
        "text": "Target macOS26, SwiftUI with AppKit.\n\nBuild SwiftUI state feeding that native report card through one snapshot. Editing its name must preserve selection. Selection changes update current visible/value state before an optional animation callback; unchanged requests should not notify or animate. Reduced motion must still apply the final state, with no animation. Reentrant callbacks may change selection again. Reduced transparency chooses an opaque background policy and can return to normal later.\n\nProvide complete code and focused unit tests; no UI automation.\n",
        "sha256": "2a88209aad2736c45e6ecb340c2e7652dc3905ca5b0dae8f8e9228ded80c42d9"
      },
      "rubric": {
        "path": "code-examples/swiftui/forwarding-macos-v1/evaluation/preference-forwarding.rubric.md",
        "sha256": "447733d834024194536376794685257ce406a439e21f84b8213aae6f9e4052cf"
      },
      "manifest": "code-examples/swiftui/forwarding-macos-v1/manifest.json",
      "testIds": [
        "StoreTests/testBindingWritesSameSnapshotConsumedByWrapper",
        "StoreTests/testSelectionUpdatesBeforeAnimationCallback",
        "StoreTests/testReducedMotionStillUpdatesFinalState",
        "StoreTests/testUnchangedSelectionDoesNotNotifyOrAnimate",
        "StoreTests/testBothSelectionDirectionsUseCurrentStatus",
        "StoreTests/testReentrantAnimationPreservesLatestState",
        "StoreTests/testReduceTransparencyPolicyChoosesOpaque",
        "StoreTests/testPreferenceChangeRestoresNormalPolicy",
        "StoreTests/testTitleEditDoesNotEraseSelection"
      ],
      "outputs": {
        "status": "not-run",
        "attempts": []
      },
      "analysis": null

{
  "schema": 1,
  "cases": [
    {
      "id": "forwarding-macos-v1/native-metadata",
      "platform": "macOS",
      "framework": "SwiftUI",
      "nativeFramework": "AppKit",
      "family": "native-metadata",
      "subject": {
        "path": "code-examples/swiftui/forwarding-macos-v1/evaluation/native-metadata.prompt.md",
        "text": "Target macOS26, SwiftUI with AppKit.\n\nThe application supplies native card layout; preserve it. This task covers semantic/action configuration, not screen layout. Build a SwiftUI wrapper around a native report card with an independent heading, Open button, Details button and status readout. Its snapshot has id/title/status(optional)/hint(optional)/selected/enabled/landmark fields. On every update, preserve controls and show current contextual names, a non-color selected/not-selected readout, value and optional help; clear obsolete values/help when absent. Preserve unrelated native trait bits and ordered children. Use platform-appropriate scalable text configuration without claiming TV27 Larger Text on TV26.\n\nProvide complete code and focused unit tests; no UI automation.\n",
        "sha256": "d9f01c2c8acad32fbbf3f624da947bdcf5b081a12f00a0c406535599f31d7ee1"
      },
      "rubric": {
        "path": "code-examples/swiftui/forwarding-macos-v1/evaluation/native-metadata.rubric.md",
        "sha256": "9a4a3ecb0be9e3ba9e22fafd1feeee3ee25a184be7e2aeb62f506998243e9068"
      },
      "manifest": "code-examples/swiftui/forwarding-macos-v1/manifest.json",
      "testIds": [
        "ForwardingTests/testInitialExplicitName",
        "ForwardingTests/testNamesRefreshWithoutReconstruction",
        "ForwardingTests/testValueMatchesVisibleState",
        "ForwardingTests/testBothSelectionTransitionsClearOldValue",
        "ForwardingTests/testNilStatusDoesNotLeaveOldText",
        "ForwardingTests/testEmptyStatusDoesNotAddSpuriousSeparator",
        "ForwardingTests/testHintCanBeSet",
        "ForwardingTests/testNilHintClearsOldHelp",
        "ForwardingTests/testChangedHintReplacesRatherThanAppends",
        "ForwardingTests/testDisabledStateForwardedToBothControls",
        "ForwardingTests/testReenableRestoresBothControls",
        "ForwardingTests/testControlIdentityPreservedAcrossUpdates",
        "ForwardingTests/testNamedContainerPreservesOrderedChildren",
        "ForwardingTests/testHeadingIsAddedAndRemoved",
        "ForwardingTests/testUnrelatedNativeTraitsSurviveSelection",
        "ForwardingTests/testTextConfigurationUsesScalableNativeFont",
        "ForwardingTests/testLocalizedAndUnicodeNamesPreserved",
        "ForwardingTests/testReconfigureDoesNotAccumulateChildren"
      ],
      "outputs": {
        "status": "not-run",
        "attempts": []
      },
      "analysis": null

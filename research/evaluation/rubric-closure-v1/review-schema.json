{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "caseId", "subjectSha256", "rubricSha256", "answer", "review"],
  "properties": {
    "schema": {"const": 1},
    "caseId": {"type": "string", "minLength": 1},
    "subjectSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rubricSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "answer": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "sha256", "provenance"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 1000000},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "provenance": {"enum": ["captured-subject", "synthetic-controller-fixture"]}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer", "independentClaimed", "decisions"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "independentClaimed": {"type": "boolean"},
        "decisions": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["criterionId", "outcome", "basis", "rationale", "quote", "sourceRefs"],
            "properties": {
              "criterionId": {"type": "string", "minLength": 1},
              "outcome": {"enum": ["met", "gap", "inconclusive", "not-applicable"]},
              "basis": {"const": "answer-review"},
              "rationale": {"type": "string", "minLength": 12},
              "quote": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["startUTF16", "endUTF16", "text"], "properties": {"startUTF16": {"type": "integer", "minimum": 0}, "endUTF16": {"type": "integer", "minimum": 1}, "text": {"type": "string", "minLength": 1}}}]},
              "sourceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
            }
          }
        }
      }
    }
  }
}

      "status": "draft-not-run",
      "subject": {
        "path": "code-examples/swiftui/ios-v1/evaluation/documents.prompt.md",
        "sha256": "7310de6a5160a4cccc83aba9c3d77d4a824b71515ddc53625310188846281691",
        "text": "Target iOS26, SwiftUI.\n\nOur SwiftUI article list has stable string IDs, titles and a flag identifying important articles. Keep visible Open and Delete operations on each row, and add shortcut navigation to important articles without requiring it for ordinary use. Updates may rename, reorder or remove articles. Reject duplicate IDs atomically; preserve surviving selection. Old captured actions must not apply to a rebound revision, and deleted selections must clear.\n\nProvide complete code and focused compile/unit tests. No UI automation.\n"
      },
      "rubric": {
        "path": "code-examples/swiftui/ios-v1/evaluation/documents.rubric.md",

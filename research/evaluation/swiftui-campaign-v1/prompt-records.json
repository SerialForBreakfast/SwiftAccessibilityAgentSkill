      ],
      "status": "draft-not-run",
      "subject": {
        "path": "code-examples/swiftui/ios-v1/evaluation/forms.prompt.md",
        "sha256": "3c54c7b993ec8918a1cd07a12dd6443a3d3a7386582d112520cf1021310ea91d",
        "text": "Target iOS26, SwiftUI.\n\nOur SwiftUI email form uses an injected main-actor validator taking the current string and a completion. A nil error means success, a nonempty string is a user-facing error, and an empty error is a service failure. Replies may be synchronous, duplicated or out of order. Edits, cancellation and another Save must invalidate obsolete replies. Preserve raw input; Save may reenter validation. Show current errors visibly and keep the existing form controls.\n\nProvide complete code and focused compile/unit tests. No UI automation.\n"
      },
      "rubric": {
        "path": "code-examples/swiftui/ios-v1/evaluation/forms.rubric.md",
        "sha256": "060e53a281ff32f520468d2e40439a37ab90d4411da3ae832c9cd1c0d0ccd84a"
      },

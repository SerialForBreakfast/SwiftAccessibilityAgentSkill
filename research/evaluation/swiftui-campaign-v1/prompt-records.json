      "status": "draft-not-run",
      "subject": {
        "path": "code-examples/swiftui/ios-v1/evaluation/semantics.prompt.md",
        "sha256": "74d04592641f2fb2a3050be50548406afd9582cbf473bccf67976bfdbf3e6076",
        "text": "Target iOS26, SwiftUI.\n\nOur SwiftUI settings area has a Downloads toggle, Help button and volume readout. Keep the ordinary controls and their current callbacks. Updates can change title, priority and status without reconstructing the state object. Make the names and state reflect current data. Add five-point accessible volume adjustment through the same bounded setter as ordinary controls; values range from0 to100 and unchanged or disabled requests must not call back. Preserve a valid native Toggle rather than inventing a missing-value defect.\n\nProvide complete code and focused compile/unit tests. No UI automation.\n"
      },
      "rubric": {
        "path": "code-examples/swiftui/ios-v1/evaluation/semantics.rubric.md",
        "sha256": "b9f4ce1f8bb89311630973c5a8a2aedd08cc2ba6fa8f31fdb820d178e3d063bc"

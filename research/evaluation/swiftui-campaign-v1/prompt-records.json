    {
      "id": "swiftui-ios-v1/lifecycle",
      "platform": "iOS",
      "framework": "SwiftUI",
      "interopFramework": null,
      "family": "lifecycle",
      "guidelines": [
        "G-006",
        "G-013"
      ],
      "status": "draft-not-run",
      "subject": {
        "path": "code-examples/swiftui/ios-v1/evaluation/lifecycle.prompt.md",
        "sha256": "90629dd9d60ff9063e86301fadc4998f412c5b06214fd2ef241ad7e1ee33d310",
        "text": "Target iOS26, SwiftUI.\n\nOur SwiftUI details sheet needs a clear entry target and a return target after dismissal. Keep the ordinary Open and Close controls. The originating item may disappear while the sheet is open; use a persistent fallback. Multiple presentation generations and old dismissal callbacks are possible. Resolve the current eligible target at completion and ignore stale or repeated completion. A restoration request may synchronously open another sheet.\n\nProvide complete code and focused compile/unit tests. No UI automation.\n"
      },
      "rubric": {
        "path": "code-examples/swiftui/ios-v1/evaluation/lifecycle.rubric.md",
        "sha256": "a7b49c158a6f31cae5387e831cf3c385ea1275643861fcaa6377fc202cdbe54a"
      },
